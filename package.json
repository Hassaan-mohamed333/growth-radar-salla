{
  "name": "growth-radar-salla",
  "version": "0.1.0",
  "private": true,
  "description": "Growth Radar for Salla (راصد) monorepo",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @growth-radar/database db:generate",
    "db:migrate": "pnpm --filter @growth-radar/database db:migrate",
    "db:studio": "pnpm --filter @growth-radar/database db:studio",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "test:integration": "pnpm --filter @growth-radar/backend test:integration"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  }
}

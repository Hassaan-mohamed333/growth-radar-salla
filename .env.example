# ---- Shared ----
NODE_ENV=development

# ---- Database (packages/database + backend) ----
DATABASE_URL=postgresql://radar:radar@localhost:5432/growth_radar?schema=public

# ---- Redis (webhook idempotency) ----
REDIS_URL=redis://localhost:6379

# ---- Backend ----
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
# Session JWT signing key (>= 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=
# Session lifetime in seconds (default 12h).
SESSION_TTL_SECONDS=43200
# Only for production when dashboard and API are on sibling subdomains, e.g. .example.com
# SESSION_COOKIE_DOMAIN=

# AES-256-GCM key for Salla OAuth tokens: 32 random bytes, base64-encoded.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=1

# ---- Sales sync (Salla orders -> sales_snapshots) ----
SALES_SYNC_ENABLED=true
SALES_SYNC_INTERVAL_MINUTES=60
# Days of order history pulled the first time a store is synced.
SALES_BACKFILL_DAYS=90

# ---- Product catalogue sync (Salla products -> products) ----
PRODUCT_SYNC_ENABLED=true
# Safety net only; product.* webhooks keep the catalogue fresh in between (min 15).
PRODUCT_SYNC_INTERVAL_MINUTES=360

# ---- Recommendation engine ----
RECOMMENDATIONS_ENABLED=true
RECOMMENDATIONS_INTERVAL_MINUTES=60
# A competitor must be at least this % cheaper before an alert is raised.
RECOMMENDATION_MIN_GAP_PCT=2
# Suggested prices keep at least this % margin over the product cost price.
# Prices are only ever suggested when the cost is known; nothing is applied to Salla automatically.
RECOMMENDATION_MIN_MARGIN_PCT=10

# ---- Competitor price scraping (opt-in) ----
SCRAPER_ENABLED=false
# Minutes between re-fetches of one listing (min 15).
SCRAPER_INTERVAL_MINUTES=360
SCRAPER_BATCH_SIZE=50
# Pause between two requests to the same domain.
SCRAPER_DOMAIN_DELAY_MS=2000
# SCRAPER_USER_AGENT=GrowthRadarBot/1.0 (merchant price monitoring)

# ---- Salla ----
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
# OAuth callback registered on the Salla Partners app (must match exactly).
SALLA_REDIRECT_URI=http://localhost:4000/api/v1/auth/salla/callback
# Space-separated Salla scopes. The default and what each scope is for live in
# apps/backend/src/config/env.ts (the single source). Set SALLA_OAUTH_SCOPES here only to override.
# Merchants connected before a scope was added must re-authorize. If login fails with
# invalid_scope, the names differ from the portal's - copy the exact names shown there.
# Webhook secret from the Salla Partners portal (app > Webhooks)
SALLA_WEBHOOK_SECRET=
# "signature" (HMAC-SHA256 over raw body, X-Salla-Signature) or "token" (static token in Authorization header).
# Fixed by config on purpose: never trust the request's own X-Salla-Security-Strategy header.
SALLA_WEBHOOK_STRATEGY=signature

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:4000

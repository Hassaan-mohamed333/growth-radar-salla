# ---------- API ----------
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000            # public URL of the API (used for OAuth redirect_uri)
WEB_URL=http://localhost:3000            # public URL of the Next.js app (CORS + post-login redirect)

# App role: runs API only ("api"), BullMQ workers only ("worker"), or both ("all").
# Production: run separate processes so workers are isolated from the HTTP surface.
APP_ROLE=all

# Runtime DB role MUST be a non-superuser, non-owner role so Postgres RLS is enforced.
DATABASE_URL=postgresql://radar_app:radar_app_pw@localhost:5432/radar?schema=public
# Owner role used ONLY by `prisma migrate` (never by the running app).
MIGRATION_DATABASE_URL=postgresql://radar_owner:radar_owner_pw@localhost:5432/radar?schema=public
REDIS_URL=redis://localhost:6379

# ---------- Salla (Partners Portal -> your app -> OAuth) ----------
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_AUTH_URL=https://accounts.salla.sa/oauth2/auth
SALLA_TOKEN_URL=https://accounts.salla.sa/oauth2/token
SALLA_USERINFO_URL=https://accounts.salla.sa/oauth2/user/info
SALLA_API_BASE=https://api.salla.dev/admin/v2
SALLA_SCOPES="offline_access"            # add read scopes your app registered, e.g. orders.read products.read
SALLA_USE_PKCE=true
# Webhook security: "signature" (HMAC-SHA256 of raw body) or "token"
SALLA_WEBHOOK_STRATEGY=signature
SALLA_WEBHOOK_SECRET=

# ---------- Crypto / sessions ----------
# 32-byte keys, base64. Generate: openssl rand -base64 32
# Keyring format: "<keyId>:<base64key>[,<keyId>:<base64key>...]"; first entry encrypts, all decrypt (rotation).
TOKEN_ENCRYPTION_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES
# >= 32 chars, independent of the encryption key
SESSION_JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
SESSION_TTL_SECONDS=28800
# >= 32 chars; HMAC key used to pseudonymise Salla customer ids (we never store customer name/phone/email)
PII_HASH_KEY=REPLACE_WITH_ANOTHER_LONG_RANDOM_STRING_AT_LEAST_32

# ---------- Web ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000
# Dev only: render the dashboard with fixtures when the API is unreachable
DASHBOARD_DEMO_FALLBACK=true
